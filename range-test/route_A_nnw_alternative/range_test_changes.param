BATT_MONITOR,3
BATT_VOLT_MULT,11.18
BATT_CAPACITY,5200
BATT_LOW_VOLT,14.8
BATT_CRT_VOLT,14.0
BATT_LOW_TIMER,10
BATT_FS_LOW_ACT,2
BATT_FS_CRT_ACT,1
BATT_ARM_VOLT,16.0
